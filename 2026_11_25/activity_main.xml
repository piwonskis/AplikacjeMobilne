<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nadaj Przesyłkę - numer zdającego"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:paddingBottom="15dp" />

        <RadioGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbPocztowka"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pocztówka"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="List" />

            <RadioButton
                android:id="@+id/rbPaczka"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paczka" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ulica z numerem" />

            <EditText
                android:id="@+id/etUlica"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:hint="Ulica z numerem"
                android:inputType="text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kod pocztowy" />

            <EditText
                android:id="@+id/etKod"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:hint="Kod pocztowy"
                android:inputType="text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Miasto" />

            <EditText
                android:id="@+id/etMiasto"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:hint="Miasto"
                android:inputType="text" />

        </LinearLayout>

        <Button
            android:id="@+id/btnCena"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sprawdź Cenę"
            android:layout_gravity="center"
            android:layout_marginTop="15dp" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/list" />

        <TextView
            android:id="@+id/tvCena"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cena: "
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginTop="15dp" />

        <Button
            android:id="@+id/btnZatwierdz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zatwierdź"
            android:layout_gravity="center"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</ScrollView>
