<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/Beige"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brown"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/game_title"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/buttonRollDice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:backgroundTint="@color/chocolate"
        android:gravity="center"
        android:text="@string/roll_dice_button"
        android:textColor="@color/white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/imageViewDie1"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="9dp"
            android:contentDescription="@string/dice_image_description"
            app:srcCompat="@drawable/question" />

        <ImageView
            android:id="@+id/imageViewDie2"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="9dp"
            android:contentDescription="@string/dice_image_description"
            app:srcCompat="@drawable/question" />

        <ImageView
            android:id="@+id/imageViewDie3"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="9dp"
            android:contentDescription="@string/dice_image_description"
            app:srcCompat="@drawable/question" />

        <ImageView
            android:id="@+id/imageViewDie4"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="9dp"
            android:contentDescription="@string/dice_image_description"
            app:srcCompat="@drawable/question" />

        <ImageView
            android:id="@+id/imageViewDie5"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="9dp"
            android:contentDescription="@string/dice_image_description"
            app:srcCompat="@drawable/question" />

    </LinearLayout>

    <TextView
        android:id="@+id/textViewRoundScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:text="@string/round_score_label"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/textViewTotalScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:text="@string/total_score_label"
        android:textSize="16sp" />

    <Button
        android:id="@+id/buttonResetScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:backgroundTint="@color/chocolate"
        android:gravity="center"
        android:text="@string/reset_score_button"
        android:textColor="@color/white" />

</LinearLayout>