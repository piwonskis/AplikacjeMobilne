<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B0C4DE"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dane pracownika"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#000000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Imię"
                android:textColor="#000000" />

            <EditText
                android:id="@+id/editImie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:inputType="textPersonName"
                android:padding="8dp"
                android:textColor="#000000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Nazwisko"
                android:textColor="#000000" />

            <EditText
                android:id="@+id/editNazwisko"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:inputType="textPersonName"
                android:padding="8dp"
                android:textColor="#000000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Stanowisko"
                android:textColor="#000000" />

            <Spinner
                android:id="@+id/spinnerStanowisko"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:minHeight="48dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Generowanie hasła"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#000000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ile znaków?"
                android:textColor="#000000" />

            <EditText
                android:id="@+id/editIleZnakow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:inputType="number"
                android:padding="8dp"
                android:textColor="#000000" />

            <CheckBox
                android:id="@+id/checkLitery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Małe i wielkie litery"
                android:textColor="#000000" />

            <CheckBox
                android:id="@+id/checkCyfry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cyfry"
                android:textColor="#000000" />

            <CheckBox
                android:id="@+id/checkSpecjalne"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Znaki specjalne"
                android:textColor="#000000" />

            <Button
                android:id="@+id/btnGeneruj"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#4682B4"
                android:text="Generuj hasło"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <Button
            android:id="@+id/btnZatwierdz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#4682B4"
            android:text="Zatwierdź"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>
